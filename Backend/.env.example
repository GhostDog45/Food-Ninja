# Flask/PostgreSQL backend configuration
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/food_ninja
JWT_SECRET=replace-with-a-long-random-secret

# Required invitation code for admin registration
admin_invitation_code=replace-with-your-admin-invitation-code

# Brevo SMTP email verification
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your-brevo-smtp-login
BREVO_SMTP_PASSWORD=your-brevo-smtp-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Food-Ninja
